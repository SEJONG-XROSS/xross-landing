# 도입 상담 신청을 전달받을 웹훅 URL (Slack Incoming Webhook, Discord Webhook, Google Apps Script 등)
# 운영 환경에서 설정하지 않으면 문의 폼이 "접수할 수 없습니다" 오류를 반환합니다.
CONTACT_WEBHOOK_URL=
# 웹훅 수신 측(예: scripts/google-sheets-contact.gs)과 공유하는 비밀 값. 스크립트 속성 SECRET과 같아야 합니다.
CONTACT_WEBHOOK_SECRET=

# 공유 미리보기(OG) 이미지의 기준 URL. Vercel에서는 자동으로 감지됩니다.
NEXT_PUBLIC_SITE_URL=
